{
  "name": "gamerhq-staging",
  "services": {
    "gamerhq-staging": {
      "profiles": ["live-acceptance"],
      "image": "${GAMERHQ_STAGING_IMAGE:?Set a reviewed immutable staging image}",
      "container_name": "gamerhq-staging-bot",
      "restart": "no",
      "init": true,
      "user": "10001:10001",
      "env_file": [{"path": "/etc/gamerhq/staging/bot.env", "required": false}],
      "environment": {
        "GAMERHQ_DB_PATH": "/app/runtime/data/gamerhq.db",
        "GAMERHQ_WEB_API_ENABLED": "true",
        "GAMERHQ_WEB_API_HOST": "0.0.0.0",
        "GAMERHQ_WEB_API_PORT": "8080",
        "GAMERHQ_EXTERNAL_SKILLS": "event-manager"
      },
      "ports": ["127.0.0.1:18080:8080"],
      "volumes": [
        "/opt/gamerhq-staging/data:/app/runtime/data:Z",
        "/opt/gamerhq-staging/backups:/app/backups:Z"
      ],
      "networks": ["staging"],
      "read_only": true,
      "tmpfs": ["/tmp:rw,noexec,nosuid,size=32m,mode=1777"],
      "cap_drop": ["ALL"],
      "security_opt": ["no-new-privileges:true"],
      "pids_limit": 128,
      "mem_limit": "512m",
      "cpus": 1,
      "stop_grace_period": "30s",
      "logging": {"driver": "json-file", "options": {"max-size": "5m", "max-file": "2"}}
    }
  },
  "networks": {"staging": {"name": "gamerhq-staging-private", "driver": "bridge"}}
}
