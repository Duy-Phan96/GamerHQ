{
  "environment": "staging",
  "workerEnabled": false,
  "root": "/opt/gamerhq-staging",
  "configurationRoot": "/etc/gamerhq/staging",
  "database": "/opt/gamerhq-staging/data/gamerhq.db",
  "artifactRoot": "/opt/gamerhq-staging/artifacts",
  "workRoot": "/opt/gamerhq-staging/worker",
  "backupRoot": "/opt/gamerhq-staging/backups",
  "composeFile": "/etc/gamerhq/staging/compose.json",
  "botEnvFile": "/etc/gamerhq/staging/bot.env",
  "releaseFile": "/etc/gamerhq/staging/event-manager.release.json",
  "sdkReleaseFile": "/etc/gamerhq/staging/sdk.release.json",
  "verificationFile": "/opt/gamerhq-staging/verification.json",
  "offlineVerificationFile": "/opt/gamerhq-staging/offline-verification.json",
  "service": "gamerhq-staging",
  "container": "gamerhq-staging-bot",
  "dockerDaemonId": "REPLACE_WITH_APPROVED_VPS_DOCKER_DAEMON_ID",
  "hostSourceCommit": "REPLACE_WITH_REVIEWED_HOST_SOURCE_COMMIT",
  "baseImage": "REPLACE_WITH_REVIEWED_LOCAL_IMMUTABLE_HOST_IMAGE",
  "sdkWheel": "gamerhq_skill_sdk-0.3.0-py3-none-any.whl",
  "sdkVersion": "0.3.0",
  "sdkSha256": "REPLACE_WITH_REVIEWED_SDK_SHA256",
  "healthUrl": "http://127.0.0.1:18080",
  "healthSecretEnv": "GAMERHQ_STAGING_WEB_API_SECRET",
  "releaseTokenEnv": "GAMERHQ_SKILL_RELEASE_TOKEN",
  "trustedRepositories": ["Duy-Phan96/gamerhq-skill-event-manager", "Duy-Phan96/GamerHQ"],
  "privateArtifactSource": true,
  "stagingBotId": "0",
  "stagingGuildId": "0",
  "productionBotId": "0",
  "productionGuildId": "0",
  "categoryId": "0",
  "voiceCategoryId": "0",
  "approvedCapabilities": {"event-manager": ["storage.skill", "storage.atomic", "scheduler.jobs", "discord.resources.manage"]},
  "updatePolicy": {"channel": "stable", "automatic_compatible": false}
}
