# Required when starting the Discord bot. Never commit real credentials.
DISCORD_TOKEN=
GUILD_ID=0

# Existing public Choose Your Games channel; configure before using its overview.
CHOOSE_GAMES_CHANNEL_ID=0

# Optional legacy channel settings. New suggestion delivery uses managed Staff storage.
GAME_SUGGESTIONS_CHANNEL_ID=0
INTRODUCTIONS_CHANNEL_ID=0

# Local development: path relative to this repository, or an absolute private path.
# Keep production data outside the code checkout. Compose overrides this in-container.
GAMERHQ_DB_PATH=runtime/data/gamerhq.db

# Optional verified external Instant Gaming bot user ID; 0 leaves it unconfigured.
# Posting in gaming-news/gaming-deals and private ig-purchases/ig-buyer-ranking.
# No partner credentials required.
INSTANT_GAMING_BOT_ID=0
# Optional USER ID overrides; 0 uses the known DealGecko/Jockie/Pancake defaults in config.py.
DEALGECKO_BOT_ID=0
JOCKIE_MUSIC_BOT_ID=0
PANCAKE_BOT_ID=0

# Optional gaming-deals comparison replies; requires Discord Message Content Intent.
GOCDKEYS_ENABLED=false
GOCDKEYS_REFERRAL_CODE=kas66b
