DISCORD_TOKEN=YOUR_TOKEN_HERE

# Production: use a persistent absolute host path. Docker Compose overrides this
# inside the container with /app/data/gamerhq.db.
GAMERHQ_DB_PATH=C:\GamerHQ\data\gamerhq.db

# Right-click GamerHQ server -> Copy Server ID (Developer Mode must be enabled)
GUILD_ID=0

# Your existing #choose-your-games text channel
CHOOSE_GAMES_CHANNEL_ID=0

# Private staff channel where /game suggest posts suggestions
GAME_SUGGESTIONS_CHANNEL_ID=0
INTRODUCTIONS_CHANNEL_ID=
