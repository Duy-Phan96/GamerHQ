# Canonical configuration schema. Production values stay in /opt/gamerhq/.env.
# Required: Discord bot token. No safe usable default; keep blank until configured.
DISCORD_TOKEN=
# Required: production guild ID. 0 is an unconfigured safe default.
GUILD_ID=0
# Required for the game selector: existing channel ID. 0 disables resolution.
CHOOSE_GAMES_CHANNEL_ID=0
# Optional legacy suggestion target. 0 uses managed Staff storage.
GAME_SUGGESTIONS_CHANNEL_ID=0
# Optional legacy introductions target. 0 leaves the legacy override unset.
INTRODUCTIONS_CHANNEL_ID=0
# Required in production: private persistent SQLite path. Compose overrides this.
# Safe local default below; never copy this development DB over the production DB.
GAMERHQ_DB_PATH=runtime/data/gamerhq.db
# Optional bootstrap IDs. /server manage -> Integrations stores guild bot IDs in SQLite;
# stored assignments take precedence. Secrets remain in this environment file.
# Optional verified Instant Gaming bot user ID. 0 leaves it unconfigured without a stored ID.
INSTANT_GAMING_BOT_ID=0
# Optional Amazon affiliate/publisher bot user ID. Prefer /server manage -> Integrations.
AMAZON_BOT_ID=0
# Optional verified DealGecko user ID override. 0 uses the public default in config.py.
DEALGECKO_BOT_ID=0
# Optional verified Jockie Music user ID override. 0 uses the public default.
JOCKIE_MUSIC_BOT_ID=0
# Optional verified Pancake user ID override. 0 uses the public default.
PANCAKE_BOT_ID=0
# Optional legacy flag. Safe default false; automatic GoCDKeys scraping is unsupported.
GOCDKEYS_ENABLED=false
# Optional referral attribution for manually prepared GoCDKeys links. Existing public default.
GOCDKEYS_REFERRAL_CODE=kas66b
# Optional hidden Twitch beta. Safe production default false.
STREAMER_HUB_ENABLED=false
# Optional streamer role selector. Safe production default false.
STREAMER_ROLE_SELECTION_ENABLED=false
# Optional public Twitch application client ID; required only for enabled Twitch beta.
# No usable default; leave blank when beta is disabled. No Twitch secret is needed.
TWITCH_CLIENT_ID=

# Optional comma-separated allowlist for additional already-installed external Skill IDs.
# Reviewed bundled external Skills from requirements-skills.lock are loaded separately.
# Example: GAMERHQ_EXTERNAL_SKILLS=hello-world,server-reminders
# GamerHQ never clones or installs remote code at runtime.
GAMERHQ_EXTERNAL_SKILLS=

# Optional internal HTTP transport for the trusted gamerhq-web BFF. Disabled by default.
GAMERHQ_WEB_API_ENABLED=false
# Listener bind address. Keep loopback when the BFF runs on the same host.
GAMERHQ_WEB_API_HOST=127.0.0.1
# Listener TCP port for the internal Host Web API.
GAMERHQ_WEB_API_PORT=8080
# Required when enabled. Generate a unique random server-to-server secret of at least 32 characters.
GAMERHQ_WEB_API_SECRET=


# Optional but required for Skills that store credentials through secrets.skill.
# Generate once and keep it stable across deploys/updates:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotating this key without migrating stored Skill secrets makes existing secrets unreadable.
GAMERHQ_SKILL_SECRET_KEY=
